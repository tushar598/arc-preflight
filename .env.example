# ============================================================
# Arc Preflight — Environment Configuration
# Sourced from https://docs.arc.network (official Arc docs)
# ============================================================

# ------------------------------------
# Arc Mainnet (Chain ID: 5042)
# ------------------------------------
MAINNET_RPC_URL=https://rpc.mainnet.arc.io
MAINNET_CHAIN_ID=5042
MAINNET_EXPLORER_URL=https://explorer.arc.io

# ------------------------------------
# Arc Testnet (Chain ID: 5042002)
# ------------------------------------
TESTNET_RPC_URL=https://rpc.testnet.arc.network
TESTNET_CHAIN_ID=5042002
TESTNET_EXPLORER_URL=https://explorer.testnet.arc.io

# ------------------------------------
# USDC Contract (same address on both mainnet and testnet)
# Optional ERC-20 interface to the native USDC balance (6 decimals)
# ------------------------------------
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ------------------------------------
# Arc Transaction Extension Contracts
# (same address on both mainnet and testnet)
# ------------------------------------
MEMO_ADDRESS=0x5294E9927c3306DcBaDb03fe70b92e01cCede505
MULTICALL3FROM_ADDRESS=0x522fAf9A91c41c443c66765030741e4AaCe147D0

# ------------------------------------
# Known blocklisted test address (Testnet only)
# Derived from mnemonic: "test test test test test test test test test test test junk" (index 1)
# Sending to/from this address will revert with runtime-transfer-check.
# ------------------------------------
TESTNET_BLOCKLISTED_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# ------------------------------------
# Fee Market
# Minimum base fee on Arc: 20 Gwei
# Transactions with maxFeePerGas < 20 Gwei are silently dropped.
# ------------------------------------
MIN_BASE_FEE_GWEI=20
