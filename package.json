{
  "name": "arc-preflight-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "predev": "npm run sdk:build",
    "build": "npm run sdk:build && next build",
    "build:app": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sdk:build": "npm run build -w arc-preflight",
    "sdk:typecheck": "npm run typecheck -w arc-preflight",
    "sdk:test": "npm run test -w arc-preflight",
    "sdk:test:live": "npm run test:live -w arc-preflight",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "contracts:deploy": "contracts/script/deploy.sh",
    "sync:sanctions": "tsx scripts/sync-lists.ts"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.103.1",
    "arc-preflight": "*",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "viem": "^2.56.8"
  }
}
