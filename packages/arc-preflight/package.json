{
  "name": "arc-preflight",
  "version": "0.1.0",
  "description": "Zero-infrastructure preflight check for USDC transfers on Arc — know if a transfer will revert before paying gas.",
  "keywords": [
    "arc",
    "usdc",
    "preflight",
    "blocklist",
    "viem",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tusharsinghchouhan/arc-preflight.git"
  },
  "bugs": {
    "url": "https://github.com/tusharsinghchouhan/arc-preflight/issues"
  },
  "homepage": "https://github.com/tusharsinghchouhan/arc-preflight#readme",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "viem": ">=2.0.0",
    "ethers": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  },
  "devDependencies": {
    "ethers": "^6.17.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "viem": "^2.56.8",
    "vitest": "^5.0.1"
  }
}
