{
  "name": "arc-preflight",
  "version": "0.1.0",
  "description": "Zero-infrastructure preflight check for USDC transfers on Arc — know if a transfer will revert before paying gas.",
  "keywords": [
    "arc",
    "arc-network",
    "circle",
    "usdc",
    "preflight",
    "blocklist",
    "sanctions",
    "ofac",
    "compliance",
    "viem",
    "ethers",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tushar598/arc-preflight.git",
    "directory": "packages/arc-preflight"
  },
  "bugs": {
    "url": "https://github.com/tushar598/arc-preflight/issues"
  },
  "homepage": "https://github.com/tushar598/arc-preflight#readme",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "arc-preflight": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "test": "vitest run --project unit",
    "test:live": "LIVE_RPC=1 vitest run --project live",
    "test:all": "LIVE_RPC=1 vitest run",
    "test:watch": "vitest --project unit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "ethers": ">=6.0.0",
    "viem": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  },
  "devDependencies": {
    "ethers": "^6.17.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "viem": "^2.56.8",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
